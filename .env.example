APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# RISE: private disk for resident photos, and the largest photo accepted in KB
# (PHP's upload_max_filesize and post_max_size still apply when lower)
RISE_PHOTO_DISK=local
RISE_MAX_UPLOAD_KB=10240
RISE_HEIC_CONVERSION=true

# RISE: AI photo analysis (see README.md). Photos are only sent when a resident chooses "Analyze with AI".
# RISE_ANALYSIS_PROVIDER is gemini or roboflow; left blank, RISE uses Gemini once its key and model are set,
# and Roboflow otherwise. With no provider set up, RISE says analysis isn't set up and sends nothing.
RISE_ANALYSIS_PROVIDER=

# Google Gemini (Interactions API): cautious written observations of one photo, and two-photo comparisons.
# Put your own key here only, never in Git, and choose a current Gemini model that accepts images.
# The blank optional lines fall back to the defaults in config/services.php.
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_API_URL=
GEMINI_API_REVISION=
GEMINI_THINKING_LEVEL=
GEMINI_TIMEOUT=
GEMINI_MAX_IMAGE_SIDE=
ROBOFLOW_API_URL=https://serverless.roboflow.com
ROBOFLOW_API_KEY=
ROBOFLOW_MODEL_ID=
ROBOFLOW_CONFIDENCE=0.4
ROBOFLOW_TIMEOUT=20
ROBOFLOW_MAX_IMAGE_SIDE=1280

# Optional AI photo comparison. RISE_COMPARISON_DRIVER is gemini or openai_compatible; left blank, it uses Gemini
# once Gemini is set up, and stays off otherwise. The openai_compatible driver needs the RISE_COMPARISON_* values
# below, and residents see RISE_COMPARISON_PROVIDER_NAME before anything is sent. See README.md.
RISE_COMPARISON_DRIVER=
RISE_COMPARISON_PROVIDER_NAME=
RISE_COMPARISON_API_URL=
RISE_COMPARISON_API_KEY=
RISE_COMPARISON_MODEL=
RISE_COMPARISON_TIMEOUT=45
RISE_COMPARISON_MAX_IMAGE_SIDE=1024

# Capstone evaluation workspace (researcher accounts only; see README.md). Blank uses 200 images a run, 6 a minute.
RISE_EVALUATION_MAX_ITEMS=
RISE_EVALUATION_PER_MINUTE=
